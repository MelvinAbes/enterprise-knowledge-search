EKS_APP_NAME=Enterprise Knowledge Search
EKS_ENVIRONMENT=development
EKS_LOG_LEVEL=INFO
EKS_HOST=127.0.0.1
EKS_PORT=8000
EKS_API_PREFIX=/api/v1
EKS_DATABASE_URL=postgresql+psycopg://knowledge_search:change-this-local-password@127.0.0.1:5432/knowledge_search
EKS_DOCUMENT_STORAGE_PATH=data/documents
EKS_MAX_UPLOAD_BYTES=26214400
EKS_MAX_PDF_PAGES=200
EKS_CHUNK_SIZE_TOKENS=300
EKS_CHUNK_OVERLAP_TOKENS=50
EKS_CHUNKING_STRATEGY=section_aware
EKS_REDIS_URL=redis://127.0.0.1:6379/0
EKS_INGESTION_QUEUE_NAME=document-ingestion
EKS_QDRANT_URL=http://127.0.0.1:6333
EKS_QDRANT_COLLECTION=knowledge_chunks
EKS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EKS_EMBEDDING_DIMENSIONS=384
EKS_MODEL_CACHE_PATH=model-cache
EKS_RETRIEVAL_CANDIDATE_MULTIPLIER=4
EKS_HYBRID_RRF_K=60
